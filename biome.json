{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "enabled": false
  },
  "css": {
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.agents/skills/next-*",
      "!**/.devcontainer/devcontainer-lock.json",
      "!**/packages/database/types/supabase.ts",
      "!**/skills-lock.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Date": "Temporal を使ってください。AGENTS.md の「時刻の扱い」を参照。"
            }
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "tailwind-merge": "theme.css の文字サイズなどを登録した twMerge を @shinju-date/ui からインポートしてください。",
              "temporal-polyfill": "Temporal はグローバルを使ってください。AGENTS.md の「時刻の扱い」を参照。"
            },
            "patterns": [
              {
                "group": ["temporal-polyfill/**"],
                "message": "Temporal はグローバルを使ってください。AGENTS.md の「時刻の扱い」を参照。"
              }
            ]
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/tw-merge.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/instrumentation-client.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.*", "**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "includes": [
        "**",
        "!packages/constants/src/index.ts",
        "!**/*.test.*",
        "!**/e2e/**"
      ],
      "path": "./config/biome/no-hardcoded-time-zone.grit",
      "resolutionKind": "config"
    },
    {
      "includes": [
        "**",
        "!packages/tailwind-config/**",
        "!packages/ui/src/tw-merge.ts",
        "!packages/ui/src/tw-merge.test.ts"
      ],
      "path": "./config/biome/no-default-tailwind-scale.grit",
      "resolutionKind": "config"
    }
  ],
  "tailwind": {
    "attributes": ["class", "className"],
    "mergeFunctions": ["twMerge"],
    "variantFunctions": ["cva"]
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
