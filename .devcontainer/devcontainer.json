{
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "bradlc.vscode-tailwindcss",
        "oxc.oxc-vscode",
        "unifiedjs.vscode-mdx"
      ],
      "settings": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true
      }
    }
  },
  "dockerComposeFile": ["../compose.yml", "compose.override.yml"],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {},
    "ghcr.io/devcontainers/features/terraform:1.4.5": {
      "terragrunt": "none",
      "tflint": "none",
      "version": "1.17.2"
    }
  },
  "forwardPorts": [3000, 4000, 5000, 8079, 54321, 54323, 54324],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "name": "SHINJU DATE",
  "portsAttributes": {
    "3000": {
      "label": "Web",
      "onAutoForward": "silent"
    },
    "4000": {
      "label": "Admin",
      "onAutoForward": "silent"
    },
    "5000": {
      "label": "Batch",
      "onAutoForward": "silent"
    },
    "8079": {
      "label": "Redis HTTP API",
      "onAutoForward": "silent"
    },
    "54321": {
      "label": "Supabase API",
      "onAutoForward": "silent"
    },
    "54323": {
      "label": "Supabase Studio",
      "onAutoForward": "notify"
    },
    "54324": {
      "label": "Mailpit Web UI",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "./.devcontainer/post-create.sh",
  "service": "app",
  "waitFor": "postCreateCommand",
  "workspaceFolder": "/workspaces/shinju-date"
}
