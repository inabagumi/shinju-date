{
  "name": "@shinju-date/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared UI components for SHINJU DATE applications",
  "homepage": "https://shinju.date/",
  "license": "MIT",
  "author": "Haneru Developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/inabagumi/shinju-date.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-toast": "1.3.1",
    "@shinju-date/tailwind-config": "workspace:*",
    "class-variance-authority": "0.7.1",
    "lucide-react": "catalog:",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@shinju-date/config": "workspace:*",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "jsdom": "catalog:",
    "playwright": "1.65.1",
    "postcss": "8.5.33",
    "postcss-load-config": "6.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.7",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
