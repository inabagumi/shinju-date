{
  "author": "Haneru Developers",
  "description": "Common mock server handlers using MSW for SHINJU DATE monorepo",
  "dependencies": {
    "@msw/data": "1.1.8",
    "@shinju-date/database": "workspace:*",
    "msw": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@shinju-date/config": "workspace:*",
    "@shinju-date/constants": "workspace:*",
    "@shinju-date/temporal-fns": "workspace:*",
    "@tsconfig/node20": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "@upstash/redis": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "homepage": "https://shinju.date/",
  "license": "MIT",
  "name": "@shinju-date/msw-handlers",
  "private": true,
  "repository": {
    "directory": "packages/msw-handlers",
    "type": "git",
    "url": "https://github.com/inabagumi/shinju-date.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
