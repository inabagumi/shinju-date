{
  "author": "Haneru Developers",
  "description": "Common mock server handlers using MSW for SHINJU DATE monorepo",
  "dependencies": {
    "@msw/data": "1.1.8",
    "@shinju-date/database": "workspace:*",
    "msw": "3.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@shinju-date/constants": "workspace:*",
    "@shinju-date/temporal-fns": "workspace:*",
    "@tsconfig/node20": "20.1.11",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "@upstash/redis": "1.41.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./register": {
      "import": "./dist/register.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    }
  },
  "homepage": "https://shinju.date/",
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@shinju-date/msw-handlers",
  "private": true,
  "repository": {
    "directory": "packages/msw-handlers",
    "type": "git",
    "url": "https://github.com/inabagumi/shinju-date.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.0"
}
