{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["ENABLE_MSW", "VERCEL_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "typegen"]
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    }
  },
  "ui": "tui"
}
