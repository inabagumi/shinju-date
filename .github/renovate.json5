{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  customManagers: [
    {
      customType: 'regex',
      description: 'Update versions in .claude/hooks/session-start.sh, in the same comment format as customManagers:dockerfileVersions',
      managerFilePatterns: ['/^\\.claude/hooks/session-start\\.sh$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+(?:export\\s+)?[A-Z0-9_]+?_VERSION="?(?<currentValue>[^"\\s]+?)"?\\s'
      ]
    }
  ],
  extends: ['github>inabagumi/.github//renovate-config/default.json5'],
  minimumReleaseAge: '1 day',
  packageRules: [
    {
      description: 'Read the Dev Container image tag as <image version>-<Node.js version>-bookworm, so that a Node.js major is a major update',
      matchDatasources: ['docker'],
      matchPackageNames: ['mcr.microsoft.com/devcontainers/typescript-node'],
      versioning: 'regex:^(?<minor>\\d+)-(?<major>\\d+)-bookworm$'
    },
    {
      automerge: false,
      description: 'Do not automerge a new image version, which can change the tools in the Dev Container',
      matchDatasources: ['docker'],
      matchPackageNames: ['mcr.microsoft.com/devcontainers/typescript-node'],
      matchUpdateTypes: ['minor']
    },
    {
      description: 'Update the Node.js major in .node-version, devEngines and the Dev Container image together',
      groupName: 'Node.js major',
      matchPackageNames: [
        'mcr.microsoft.com/devcontainers/typescript-node',
        'node'
      ],
      matchUpdateTypes: ['major']
    },
    {
      groupName: 'tailwindcss monorepo',
      ignoreUnstable: false,
      matchManagers: ['npm'],
      matchPackageNames: ['@tailwindcss/**', 'tailwindcss']
    }
  ],
  reviewers: ['ykzts']
}
