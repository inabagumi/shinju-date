{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in .claude/hooks/session-start.sh, in the same comment format as customManagers:dockerfileVersions",
      "managerFilePatterns": ["/^\\.claude/hooks/session-start\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+[a-zA-Z_][a-zA-Z0-9_]*=\"?(?<currentValue>[^\"\\s]+)\"?\\s"
      ]
    }
  ],
  "extends": ["github>inabagumi/renovate-config"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "groupName": "tailwindcss monorepo",
      "ignoreUnstable": false,
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tailwindcss/**", "tailwindcss"]
    }
  ],
  "reviewers": ["ykzts"]
}
