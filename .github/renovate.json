{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the version of tools that .claude/hooks/session-start.sh installs",
      "managerFilePatterns": ["/^\\.claude/hooks/session-start\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "extends": ["github>inabagumi/renovate-config"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "groupName": "tailwindcss monorepo",
      "ignoreUnstable": false,
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tailwindcss/**", "tailwindcss"]
    }
  ],
  "reviewers": ["ykzts"]
}
