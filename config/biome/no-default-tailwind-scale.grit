// Tailwind の既定の文字サイズ・角丸・影と、`dark:` を使わない
// （docs/design-guidelines.md）。`class` と `className` の値、`twMerge` と
// `cva` の引数の中の文字列を調べる。`sm:text-sm` や `hover:shadow-md` の
// ように、バリアントを付けたものも報告する。
language js

or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement()
} as $string where {
  $string <: within or {
    JsxAttribute(name=or {
      `class`,
      `className`
    }),
    `twMerge($_)`,
    `cva($_)`
  },
  or {
    // 文字サイズ（text-xs から text-9xl。text-sm/6 のような行の高さ付きを含む）
    $string <: r"(?s)(?:.*[\s'\"`])?(?:[^\s'\"`]*:)?!?text-(?:xs|sm|base|lg|[2-9]?xl)(?:/[^\s'\"`]*)?!?(?:[\s'\"`].*)?",
    // 角丸（rounded、rounded-md、rounded-t-lg など。rounded-none と rounded-full は除く）
    $string <: r"(?s)(?:.*[\s'\"`])?(?:[^\s'\"`]*:)?!?rounded(?:-(?:s|e|t|r|b|l|ss|se|ee|es|tl|tr|br|bl))?(?:-(?:xs|sm|md|lg|[2-4]?xl))?!?(?:[\s'\"`].*)?",
    // 影（shadow、shadow-sm、shadow-lg など。shadow-none は除く）
    $string <: r"(?s)(?:.*[\s'\"`])?(?:[^\s'\"`]*:)?!?shadow(?:-(?:2xs|xs|sm|md|lg|2?xl))?!?(?:[\s'\"`].*)?",
    // dark: のバリアント（md:dark:bg-black のように、ほかのバリアントの後ろも含む）
    $string <: r"(?s)(?:.*[\s'\"`:])?dark:.*"
  },
  register_diagnostic(span=$string, message="Tailwind の既定の文字サイズ（text-sm など）、角丸（rounded-md など）、影（shadow-lg など）と dark: は使わず、text-body、rounded-control、shadow-overlay とセマンティックカラーを使ってください。docs/design-guidelines.md を参照。", severity="error")
}
