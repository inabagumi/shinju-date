// タイムゾーンを直接書かず、`@shinju-date/constants` の `TIME_ZONE` を使う
// （AGENTS.md の「時刻の扱い」）。定数の定義とテストのファイルは、
// `biome.json` の `includes` で対象から外す。
language js

or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement()
} as $string where {
  $string <: r"(?s).*Asia/Tokyo.*",
  register_diagnostic(span=$string, message="タイムゾーンを直接書かず、@shinju-date/constants の TIME_ZONE を使ってください。AGENTS.md の「時刻の扱い」を参照。", severity="error")
}
