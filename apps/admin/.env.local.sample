NEXT_PUBLIC_BASE_URL=http://localhost:4000

# Supabase client (using local Supabase instance)
# `pnpm run setup` starts Supabase and fills in the URL and the keys
# from the output of: pnpm exec supabase status -o env
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash Redis (using local serverless-redis-http)
# In Dev Container: automatically started
# Otherwise `pnpm run setup` starts it (docker compose up -d --wait)
# The token must match SRH_TOKEN in config/dev-secrets.env
UPSTASH_REDIS_REST_TOKEN="HQe-H5xQJO6ADYplIW-LYFZWRMGwpSjRfHneRw52aPI"
UPSTASH_REDIS_REST_URL="http://localhost:8079"

# YouTube Data API
# Required for YouTube channel registration and manual sync in admin
# (not needed with ENABLE_MSW=true)
GOOGLE_API_KEY=""

# Twitch Helix API (App Access Token via Client Credentials)
# Required for Twitch user registration and manual sync in admin
# (not needed with ENABLE_MSW=true)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Optional: Enable MSW for testing without local services
# Set ENABLE_MSW=true to use mocks instead of real services
# ENABLE_MSW=true
# Optional: Sign in as the mock admin user without the login form (MSW only)
# MSW_SUPABASE_AUTHENTICATED=true
