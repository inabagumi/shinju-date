# Supabase client (these are required, but can be fake values when `ENABLE_MSW=true`)
NEXT_PUBLIC_SUPABASE_URL="https://fake.supabase.test"
SUPABASE_SERVICE_ROLE_KEY="fake"

# Upstash client
# Option 1: Use MSW for testing (no actual Redis needed)
# UPSTASH_REDIS_REST_TOKEN="fake"
# UPSTASH_REDIS_REST_URL="https://fake.upstash.test"
#
# Option 2: Use local Redis via serverless-redis-http (recommended for development)
# Start with: pnpm redis:start
UPSTASH_REDIS_REST_TOKEN="local_development_token"
UPSTASH_REDIS_REST_URL="http://localhost:8079"

# YouTube Data API
# Required for YouTube channel and video sync in batch jobs
# (not needed with ENABLE_MSW=true)
GOOGLE_API_KEY=""

# Twitch Helix API (App Access Token via Client Credentials)
# Required for Twitch user sync and video discovery in batch jobs
# (not needed with ENABLE_MSW=true)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Optional: Secret that Vercel Cron sends to the cron routes
# The routes do not check the request when it is not set
CRON_SECRET=""

# Optional: Revalidation of the public website's cache after a sync
# Skipped when REVALIDATE_URL is not set
REVALIDATE_SECRET_TOKEN=""
REVALIDATE_URL=""

# Optional: Enable MSW for testing without local services
# Set ENABLE_MSW=true to use mocks instead of real services
# ENABLE_MSW=true
