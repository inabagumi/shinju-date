{
  "name": "@shinju-date/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SHINJU DATE is a web service for searching videos.",
  "homepage": "https://shinju.date/",
  "license": "MIT",
  "author": "Haneru Developers",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "stylelint \"**/*.css\" && ultracite check",
    "check:dev-secrets": "node scripts/check-dev-secrets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package-exports": "node scripts/check-package-exports.mjs",
    "check:private-urls": "node scripts/check-private-urls.mjs",
    "db:export": "./scripts/export-production-data.sh",
    "db:schema": "./scripts/generate-types.sh",
    "db:import": "./scripts/import-data.sh",
    "dev": "turbo watch dev --env-mode=loose",
    "fix": "stylelint --fix \"**/*.css\" && ultracite fix",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:scripts": "vitest run --dir scripts",
    "typecheck": "turbo typecheck",
    "typegen": "turbo typegen"
  },
  "devDependencies": {
    "@shinju-date/oxlint-plugin": "workspace:*",
    "oxfmt": "0.79.0",
    "oxlint": "catalog:",
    "stylelint": "18.1.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard": "41.0.0",
    "supabase": "3.2.0",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.1",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
